+def _vard_marcar_telegram() -> None:
+    """VARD_MARCA_TELEGRAM: registra a origem antes de entregar ao agente."""
+    caminho = os.environ.get("VARD_MARCA_TELEGRAM")
+    if not caminho:
+        return
+    temporario = None
+    try:
+        alvo = Path(caminho)
+        alvo.parent.mkdir(parents=True, exist_ok=True)
+        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=alvo.parent,
+                                         suffix=".tmp", delete=False) as arquivo:
+            temporario = arquivo.name
+            json.dump({"ts": time.time()}, arquivo)
+            arquivo.flush()
+            os.fsync(arquivo.fileno())
+        os.replace(temporario, alvo)
+    except Exception:
+        pass  # A marca nunca deve interromper o canal.
+    finally:
+        if temporario:
+            try:
+                os.unlink(temporario)
+            except OSError:
+                pass


