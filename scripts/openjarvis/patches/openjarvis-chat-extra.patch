+def _chat_extra() -> Dict[str, Any]:
+    """Patch Vard: campos extras do corpo (ex.: reasoning_effort) vindos de OPENJARVIS_CHAT_EXTRA (JSON)."""
+    bruto = os.environ.get("OPENJARVIS_CHAT_EXTRA", "").strip()
+    if not bruto:
+        return {}
+    try:
+        extra = json.loads(bruto)
+        if isinstance(extra, dict):
+            return extra
+    except ValueError:
+        pass
+    logging.getLogger(__name__).warning("OPENJARVIS_CHAT_EXTRA invalido (esperado objeto JSON); ignorado")
+    return {}
+
